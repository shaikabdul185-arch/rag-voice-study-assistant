# Copy to .env and paste YOUR OWN Anthropic API key (console.anthropic.com -> API Keys).
# .env is git-ignored, so never commit it. Real environment variables take precedence over .env.
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://study:study@localhost:5432/study

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5          # or claude-sonnet-5-5 (cheaper)
# CLAUDE_EFFORT=medium
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBED_BACKEND=sentence-transformers   # "hash" = offline stub, for tests only
# WHISPER_MODEL=base.en
# CLAUDE_FALLBACKS=on                     # off = disable the server-side refusal fallback
